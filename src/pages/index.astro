---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const essays = (await getCollection('essays', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const fmt = (d) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title="Tian de Klerk">
  <section class="hero">
    <h1>Some things written down.</h1>
    <p class="sub">
      Notes and adventures in exploring and experimenting with cool tech, ranging from agentic
      AI to improving my home lab and building my smart home.
    </p>
  </section>

  <p class="section-label">Latest essays</p>

  {
    essays.map((post) => (
      <a class="post" href={`/essays/${post.slug}/`}>
        <div class="meta">
          <span>{fmt(post.data.date)}</span>
          {post.data.minutes && <span>{post.data.minutes} min</span>}
        </div>
        <h2>{post.data.title}</h2>
        <p class="dek">{post.data.description}</p>
      </a>
    ))
  }
</Base>

<style>
  .hero { padding: 64px 0 48px; }
  .hero h1 {
    font-family: 'JetBrains Mono', monospace; font-weight: 800;
    font-size: clamp(32px, 6vw, 50px); line-height: 1.06; letter-spacing: -0.04em;
    text-transform: lowercase;
  }
  .hero .sub { margin-top: 20px; color: var(--ink-soft); font-size: 18px; max-width: 52ch; }

  .section-label {
    font-family: 'JetBrains Mono', monospace; font-size: 12px; letter-spacing: 0.12em;
    color: var(--ink-soft); text-transform: uppercase; margin: 56px 0 4px;
  }

  .post {
    display: block; padding: 26px 0 26px 18px; border-top: 1px solid var(--line);
    text-decoration: none; position: relative;
  }
  .post::before {
    content: ''; position: absolute; left: 0; top: 26px; height: 22px;
    width: 4px; border-radius: 2px; background: var(--accent);
    transition: height 0.18s ease;
  }
  .post:hover::before { height: calc(100% - 52px); }
  .post .meta {
    font-family: 'JetBrains Mono', monospace; font-size: 11.5px; color: var(--ink-soft);
    display: flex; gap: 14px; margin-bottom: 10px; flex-wrap: wrap;
    text-transform: lowercase; letter-spacing: 0.02em;
  }
  .post h2 {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 24px;
    line-height: 1.24; letter-spacing: -0.03em;
  }
  .post:hover h2 { color: var(--accent); }
  .post .dek { margin-top: 9px; color: var(--ink-soft); font-size: 16px; max-width: 64ch; }

  @media (max-width: 720px) {
    .hero { padding: 46px 0 36px; }
    .post h2 { font-size: 23px; }
  }
</style>
