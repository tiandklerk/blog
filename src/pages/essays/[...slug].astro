---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => !data.draft);
  return essays.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const voiceLabel = { tian: 'TIAN', claude: 'CLAUDE', duet: 'TIAN × CLAUDE' };
const marginWho = {
  tian: 'TIAN, IN THE MARGIN',
  claude: 'CLAUDE, IN THE MARGIN',
  both: 'BOTH, IN THE MARGIN',
};
const fmt = (d) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title={`${post.data.title} — The Context Window`} description={post.data.description}>
  <article class={`essay-page ${post.data.voice}`}>
    <header class="essay-head">
      <div class="meta">
        <span class={`byline ${post.data.voice}`}>{voiceLabel[post.data.voice]}</span>
        <span>{fmt(post.data.date)}</span>
        {post.data.minutes && <span>{post.data.minutes} min</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      post.data.margin && (
        <aside class={`margin by-${post.data.margin.by}`}>
          <span class="who">{marginWho[post.data.margin.by]}</span>
          {post.data.margin.text}
        </aside>
      )
    }

    <p class="back"><a href="/">← All essays</a></p>
  </article>
</Base>

<style>
  .essay-page { padding-top: 52px; }
  .essay-head { padding-left: 22px; position: relative; margin-bottom: 36px; }
  .essay-head::before { content: ''; position: absolute; left: 0; top: 6px; bottom: 6px; width: 3px; border-radius: 2px; }
  .essay-page.tian .essay-head::before { background: var(--tian); }
  .essay-page.claude .essay-head::before { background: var(--claude); }
  .essay-page.duet .essay-head::before { background: linear-gradient(to bottom, var(--tian) 50%, var(--claude) 50%); }
  .meta { font-family: 'IBM Plex Mono', monospace; font-size: 12px; color: var(--ink-soft); display: flex; gap: 14px; margin-bottom: 12px; flex-wrap: wrap; }
  .byline.tian { color: var(--tian); }
  .byline.claude { color: var(--claude); }
  .byline.duet { color: var(--ink); }
  h1 {
    font-family: 'Fraunces', serif; font-weight: 600;
    font-size: clamp(30px, 5.4vw, 44px); line-height: 1.12; letter-spacing: -0.02em;
  }
  .dek { margin-top: 14px; color: var(--ink-soft); font-size: 18px; }

  .prose :global(p) { margin: 0 0 1.25em; font-size: 17.5px; }
  .prose :global(h2) {
    font-family: 'Fraunces', serif; font-weight: 600; font-size: 26px;
    letter-spacing: -0.01em; margin: 1.6em 0 0.6em;
  }
  .prose :global(h3) { font-family: 'Fraunces', serif; font-weight: 600; font-size: 21px; margin: 1.4em 0 0.5em; }
  .prose :global(a) { text-decoration-thickness: 1.5px; text-underline-offset: 3px; }
  .prose :global(blockquote) {
    border-left: 3px solid var(--line); padding: 4px 0 4px 18px; margin: 1.4em 0;
    font-family: 'Fraunces', serif; font-style: italic; color: var(--ink-soft);
  }
  .prose :global(code) {
    font-family: 'IBM Plex Mono', monospace; font-size: 14.5px;
    background: var(--line); padding: 2px 6px; border-radius: 4px;
  }
  .prose :global(pre) {
    background: #12151c; color: #e9e6de; border-radius: 8px;
    padding: 16px 18px; overflow-x: auto; margin: 1.4em 0;
  }
  .prose :global(pre code) { background: none; padding: 0; font-size: 14px; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.25em 1.3em; }
  .prose :global(li) { margin-bottom: 0.4em; }

  .margin {
    font-family: 'Fraunces', serif; font-style: italic; font-size: 15.5px; line-height: 1.55;
    padding: 14px 0 14px 18px; margin-top: 40px; position: relative;
  }
  .margin::before { content: ''; position: absolute; left: 0; top: 14px; bottom: 14px; width: 2px; border-radius: 2px; }
  .margin.by-claude, .margin.by-both { color: var(--margin-c); }
  .margin.by-claude::before, .margin.by-both::before { background: var(--claude); }
  .margin.by-tian { color: var(--margin-t); }
  .margin.by-tian::before { background: var(--tian); }
  .margin .who {
    font-family: 'IBM Plex Mono', monospace; font-style: normal; font-size: 11px;
    letter-spacing: 0.08em; display: block; margin-bottom: 6px;
  }
  .margin.by-claude .who, .margin.by-both .who { color: var(--claude); }
  .margin.by-tian .who { color: var(--tian); }

  .back { margin-top: 48px; font-family: 'IBM Plex Mono', monospace; font-size: 13px; }
  .back a { text-decoration: none; color: var(--ink-soft); }
  .back a:hover { color: var(--ink); }
</style>
