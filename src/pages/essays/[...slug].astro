---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  // Draft essays get pages only in local dev (npm run dev), never in the deployed build.
  const showDrafts = import.meta.env.DEV;
  const essays = await getCollection('essays', ({ data }) => showDrafts || !data.draft);
  return essays.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await post.render();

const marginWho = {
  tian: 'IN THE MARGIN',
  claude: 'IN THE MARGIN',
  both: 'IN THE MARGIN',
};
const fmt = (d) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<Base title={`${post.data.title} — Tian de Klerk`} description={post.data.description}>
  <article class="essay-page">
    {post.data.draft && (
      <div class="draft-banner">draft — visible locally only, not published to the live site</div>
    )}
    <header class="essay-head">
      <div class="meta">
        <span>{fmt(post.data.date)}</span>
        {post.data.minutes && <span>{post.data.minutes} min</span>}
      </div>
      <h1>{post.data.title}</h1>
      <p class="dek">{post.data.description}</p>
    </header>

    <div class="prose">
      <Content />
    </div>

    {
      post.data.margin && (
        <aside class="margin">
          <span class="who">{marginWho[post.data.margin.by]}</span>
          {post.data.margin.text}
        </aside>
      )
    }

    <p class="back"><a href="/">← All essays</a></p>
  </article>
</Base>

<style>
  .essay-page { padding-top: 52px; }
  .draft-banner {
    font-family: 'JetBrains Mono', monospace; font-size: 12px; color: #d29922;
    border: 1px solid #d29922; border-radius: 6px; padding: 8px 12px; margin-bottom: 28px;
    text-transform: lowercase; letter-spacing: 0.02em;
  }
  .essay-head { padding-left: 18px; position: relative; margin-bottom: 36px; }
  .essay-head::before {
    content: ''; position: absolute; left: 0; top: 6px; bottom: 6px;
    width: 4px; border-radius: 2px; background: var(--accent);
  }
  .meta {
    font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--ink-soft);
    display: flex; gap: 14px; margin-bottom: 12px; flex-wrap: wrap;
    text-transform: lowercase; letter-spacing: 0.02em;
  }
  h1 {
    font-family: 'JetBrains Mono', monospace; font-weight: 800;
    font-size: clamp(28px, 5vw, 40px); line-height: 1.14; letter-spacing: -0.04em;
  }
  .dek { margin-top: 14px; color: var(--ink-soft); font-size: 18px; }

  .prose :global(p) { margin: 0 0 1.25em; font-size: 17.5px; }
  .prose :global(h2) {
    font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: 24px;
    letter-spacing: -0.03em; margin: 1.7em 0 0.6em;
  }
  .prose :global(h3) {
    font-family: 'JetBrains Mono', monospace; font-weight: 700; font-size: 19px;
    letter-spacing: -0.02em; margin: 1.4em 0 0.5em;
  }
  .prose :global(a) { color: var(--accent); text-decoration-thickness: 1.5px; text-underline-offset: 3px; }

  /* callout-style blockquotes (used throughout the technical essays) */
  .prose :global(blockquote) {
    border-left: 4px solid var(--accent); background: var(--wash-t);
    padding: 14px 18px; margin: 1.5em 0; border-radius: 0 6px 6px 0;
  }
  .prose :global(blockquote p) { margin: 0; font-size: 16px; }
  .prose :global(blockquote p + p) { margin-top: 0.7em; }

  .prose :global(code) {
    font-family: 'JetBrains Mono', monospace; font-size: 14px;
    background: var(--code-bg); padding: 2px 6px; border-radius: 4px;
  }
  .prose :global(pre) {
    background: var(--pre-bg); color: var(--pre-fg); border: 1px solid var(--line);
    border-radius: 8px; padding: 16px 18px; overflow-x: auto; margin: 1.4em 0;
  }
  .prose :global(pre code) { background: none; padding: 0; font-size: 13.5px; color: inherit; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.25em 1.3em; }
  .prose :global(li) { margin-bottom: 0.4em; }

  /* images + captions */
  .prose :global(img) {
    display: block; max-width: 100%; height: auto; margin: 1.6em auto 0.4em;
    border: 1px solid var(--line); border-radius: 8px;
  }
  .prose :global(img + em) {
    display: block; text-align: center; font-style: normal;
    font-family: 'JetBrains Mono', monospace; font-size: 12px;
    color: var(--ink-soft); margin-bottom: 1.6em;
  }

  /* tables (the case study leans on these heavily) */
  .prose :global(table) {
    width: 100%; border-collapse: collapse; margin: 1.5em 0; font-size: 14.5px;
    display: block; overflow-x: auto;
  }
  .prose :global(th), .prose :global(td) {
    border: 1px solid var(--line); padding: 8px 12px; text-align: left; vertical-align: top;
  }
  .prose :global(th) {
    font-family: 'JetBrains Mono', monospace; font-size: 12px; text-transform: uppercase;
    letter-spacing: 0.04em; color: var(--ink-soft); background: var(--wash-t); font-weight: 500;
  }
  .prose :global(hr) { border: none; border-top: 1px solid var(--line); margin: 2.4em 0; }

  .margin {
    border-left: 4px solid var(--accent); background: var(--wash-t);
    padding: 14px 18px; margin-top: 40px; border-radius: 0 6px 6px 0;
    font-size: 15.5px; line-height: 1.55;
  }
  .margin .who {
    font-family: 'JetBrains Mono', monospace; font-size: 11px; letter-spacing: 0.08em;
    text-transform: uppercase; color: var(--accent); display: block; margin-bottom: 6px;
  }

  .back { margin-top: 48px; font-family: 'JetBrains Mono', monospace; font-size: 13px; }
  .back a { text-decoration: none; color: var(--ink-soft); }
  .back a:hover { color: var(--accent); }
</style>
