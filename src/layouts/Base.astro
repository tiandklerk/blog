---
interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const {
  title,
  description = 'Notes and adventures in exploring and experimenting with cool tech, ranging from agentic AI to improving my home lab and building my smart home.',
  wide = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title="Tian de Klerk" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      // Apply theme before paint to avoid flash
      (() => {
        const stored = localStorage.getItem('cw-theme');
        const dark = stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.classList.toggle('dark', dark);
      })();
    </script>
  </head>
  <body>
    <header>
      <div class:list={['wrap', 'mast', { wide }]}>
        <a class="name" href="/">Tian de Klerk</a>
        <div class="right">
          <nav>
            <a href="/">essays</a>
            <a href="/about">about</a>
          </nav>
          <button class="theme" id="themeBtn" aria-label="Switch between light and dark theme">
            <span class="swatch"></span><span id="themeLabel">dark</span>
          </button>
        </div>
      </div>
    </header>

    <main class:list={['wrap', { wide }]}>
      <slot />
    </main>

    <footer>
      <div class:list={['wrap', 'foot', { wide }]}>
        <span>builder · writer</span>
        <span>tiandeklerk.com</span>
      </div>
    </footer>

    <script is:inline>
      const btn = document.getElementById('themeBtn');
      const label = document.getElementById('themeLabel');
      const sync = () => {
        const dark = document.documentElement.classList.contains('dark');
        label.textContent = dark ? 'light' : 'dark';
      };
      sync();
      btn.addEventListener('click', () => {
        const dark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('cw-theme', dark ? 'dark' : 'light');
        sync();
      });
    </script>

    <style is:global>
      :root {
        --paper: #f7f8f6;
        --ink: #0d1117;
        --ink-soft: #57606a;
        --line: #d8dde3;
        --accent: #1a7f37;
        --code-bg: #eaeef2;
        --pre-bg: #0d1117;
        --pre-fg: #e6edf3;
        /* voice colors collapsed to a single accent */
        --tian: var(--accent);
        --claude: var(--accent);
        --margin-c: var(--accent);
        --margin-t: var(--accent);
        --wash-t: rgba(26, 127, 55, 0.08);
        --wash-c: rgba(26, 127, 55, 0.08);
      }
      html.dark {
        --paper: #0d1117;
        --ink: #e6edf3;
        --ink-soft: #8b949e;
        --line: #262c36;
        --accent: #3fb950;
        --code-bg: #161b22;
        --pre-bg: #010409;
        --pre-fg: #e6edf3;
        --wash-t: rgba(63, 185, 80, 0.10);
        --wash-c: rgba(63, 185, 80, 0.10);
      }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        background: var(--paper);
        color: var(--ink);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-size: 17px;
        line-height: 1.65;
        transition: background 0.25s ease, color 0.25s ease;
      }
      @media (prefers-reduced-motion: reduce) { body { transition: none; } }
      .wrap { max-width: 760px; margin: 0 auto; padding: 0 24px; }
      .wrap.wide { max-width: 1040px; }
      a { color: inherit; }
      a:focus-visible, button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

      header { padding: 26px 0 20px; border-bottom: 1px solid var(--line); }
      .mast { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 10px; }
      .mast .name { font-family: 'JetBrains Mono', monospace; font-weight: 800; font-size: 19px; text-decoration: none; letter-spacing: -0.03em; text-transform: lowercase; }
      .mast .name:hover { color: var(--accent); }
      .mast .right { display: flex; align-items: center; gap: 18px; }
      .mast nav { font-family: 'JetBrains Mono', monospace; font-size: 12.5px; color: var(--ink-soft); text-transform: lowercase; }
      .mast nav a { text-decoration: none; margin-left: 18px; }
      .mast nav a:hover { color: var(--accent); }
      .theme {
        border: 1px solid var(--line); background: none; border-radius: 6px;
        padding: 6px 12px; cursor: pointer; color: var(--ink-soft);
        font-family: 'JetBrains Mono', monospace; font-size: 11.5px; letter-spacing: 0.02em; text-transform: lowercase;
        display: inline-flex; align-items: center; gap: 8px;
      }
      .theme .swatch { width: 9px; height: 9px; border-radius: 50%; background: var(--accent); }
      .theme:hover { color: var(--ink); border-color: var(--accent); }

      footer { margin-top: 72px; border-top: 1px solid var(--line); }
      .foot {
        padding: 26px 24px 48px;
        font-family: 'JetBrains Mono', monospace; font-size: 12px; color: var(--ink-soft);
        display: flex; justify-content: space-between; flex-wrap: wrap; gap: 10px;
      }
    </style>
  </body>
</html>
